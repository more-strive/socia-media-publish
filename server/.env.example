# ===== 应用 =====
APP_NAME=社媒矩阵运营平台 Server
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 安全 =====
# JWT 密钥，生产环境务必更换为随机长字符串
SECRET_KEY=change-me-to-a-random-long-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=social_publish

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 业务开关 =====
# 发布走 mock 适配器（不真实调用平台 API）
MOCK_PUBLISH=true
# 开发模式：短信验证码直接在响应里返回
DEV_RETURN_SMS_CODE=true

# ===== AI 能力（火山引擎）=====
# 方舟 Ark 大模型（AI 文案）
ARK_API_KEY=
ARK_MODEL=doubao-seed-1-6-250615
# Seedance 视频生成
SEEDANCE_API_KEY=
# AI 模拟任务耗时（秒）
AI_MOCK_DELAY_SECONDS=10
